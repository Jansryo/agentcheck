[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"events\":{\"CheckIn(address,uint256,uint256,uint256)\":{\"params\":{\"day\":\"The UTC day number (block.timestamp / 86400).\",\"streak\":\"The user's current consecutive-day streak after this check-in.\",\"total\":\"The user's total lifetime check-ins after this check-in.\",\"user\":\"The address that checked in.\"}}},\"kind\":\"dev\",\"methods\":{\"constructor\":{\"params\":{\"_agentId\":\"Address of the Agent ID ERC-721 contract.\"}}},\"version\":1},\"userdoc\":{\"errors\":{\"AlreadyCheckedIn()\":[{\"notice\":\"Caller already checked in today (UTC).\"}],\"NotAgentIdHolder()\":[{\"notice\":\"Caller holds no Agent ID.\"}],\"NotOwner()\":[{\"notice\":\"Caller is not the owner.\"}],\"Paused()\":[{\"notice\":\"Contract is paused (emergency only).\"}]},\"events\":{\"CheckIn(address,uint256,uint256,uint256)\":{\"notice\":\"Emitted on every successful check-in.\"},\"PauseChanged(bool)\":{\"notice\":\"Emitted when the owner pauses or unpauses the contract.\"}},\"kind\":\"user\",\"methods\":{\"agentId()\":{\"notice\":\"The Agent ID ERC-721 contract used as the holder gate.\"},\"canCheckInToday(address)\":{\"notice\":\"Whether `user` can check in today (UTC): holder, not yet         checked in today, and contract not paused.\"},\"checkIn()\":{\"notice\":\"Check in for today (UTC). Requires holding >= 1 Agent ID.         One check-in per address per UTC day. Streak +1 if yesterday         was also checked in, otherwise resets to 1.\"},\"currentStreak(address)\":{\"notice\":\"Current consecutive-day streak per user.\"},\"getInfo(address)\":{\"notice\":\"All user info in one call:         (streak, total, lastDay, canCheckInToday).\"},\"getLastDay(address)\":{\"notice\":\"Last UTC day `user` checked in on (0 = never).\"},\"getStreak(address)\":{\"notice\":\"Current streak of `user`.\"},\"getTotal(address)\":{\"notice\":\"Total lifetime check-ins of `user`.\"},\"lastCheckInDay(address)\":{\"notice\":\"Last UTC day number a user checked in on (0 = never).\"},\"owner()\":{\"notice\":\"Contract owner (deployer). Can ONLY pause/unpause.\"},\"pause()\":{\"notice\":\"Pause check-ins (emergency only). Does NOT touch user state.\"},\"paused()\":{\"notice\":\"Emergency pause flag. When true, checkIn() reverts.\"},\"totalCheckIns(address)\":{\"notice\":\"Total lifetime check-ins per user.\"},\"unpause()\":{\"notice\":\"Resume check-ins.\"}},\"version\":1}},\"settings\":{\"compilationTarget\":{\"AgentCheck.sol\":\"AgentCheck\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"AgentCheck.sol\":{\"keccak256\":\"0x8c2b0167000c70baa782abdceae692d598f7dcbf5a0aadf2de5b7a83cc0aa305\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://91596e223afbbac33d66739d50a03738800ce0edf15a1e4615680b4d21a5e4b2\",\"dweb:/ipfs/Qmat2ciATfBqiu8b6Wew7GPqY322gtgmmQ4puJX2g7btJC\"]}},\"version\":1}",
